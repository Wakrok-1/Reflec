# Frontend (exposed to the browser — safe to be public, protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Same value as VAPID_PUBLIC_KEY below — the public half of a VAPID key
# pair is meant to reach the browser (Web Push applicationServerKey).
VITE_VAPID_PUBLIC_KEY=

# Server-only (Vercel serverless functions in /api). Never prefix these
# with VITE_ or they will be bundled into the client.
# Groq: https://console.groq.com/keys — free tier, no credit card.
GROQ_API_KEY=gsk_...
# Tavily: https://tavily.com — free tier, 1000 searches/month. Only used
# when the user explicitly confirms a search in chat (never automatic).
TAVILY_API_KEY=tvly-...

# Sprint 5 — Google Calendar integration. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the calendar
# scope and http(s)://<your-domain>/api/google-callback as an authorized
# redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sprint 5 — Web Push. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sprint 5 — shared secret Vercel Cron sends as `Authorization: Bearer
# <value>` on its scheduled call to /api/cron/daily-checkin. Any random
# string; generate one with `openssl rand -hex 32`.
CRON_SECRET=

# Sprint 5 — the ONE deliberate exception to this app's normal
# RLS-scoped-client rule (see README "Security notes"). Used only by
# api/google-callback.ts and api/cron/daily-checkin.ts, which have no
# user session to scope a normal client to. From Supabase dashboard:
# Project Settings -> API -> service_role key. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

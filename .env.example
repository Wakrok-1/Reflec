# Frontend (exposed to the browser — safe to be public, protected by RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel serverless functions in /api). Never prefix these
# with VITE_ or they will be bundled into the client.
ANTHROPIC_API_KEY=sk-ant-...
